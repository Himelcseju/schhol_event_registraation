# Copy to .env and set values. Do not commit .env to git.

# Required in production
SECRET_KEY=your-long-random-secret-key-here
ADMIN_PASSWORD=your-admin-password

# Database (production)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=school_event

# Optional
SCHOOL_NAME=School Event Portal
FLASK_ENV=production
PORT=5000
SITE_FEE=20
DEFAULT_BATCH_NAME=2008
